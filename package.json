{
  "name": "pdf-to-podcast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.539.0",
    "axios": "^1.11.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.7.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.knoksen.pdf-to-podcast",
    "productName": "PDF to Podcast",
    "files": [
      "dist/**",
      "electron-main.js",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  }
}